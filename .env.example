# Настройки Творог VPN. Скопируйте файл: cp .env.example .env  и заполните.
# ВАЖНО: файл .env никогда не загружайте на GitHub!

# Токен бота от @BotFather (обязательно)
BOT_TOKEN=

# Username основного бота (без @) — для ссылок из бота поддержки
BOT_USERNAME=tvorog_vpn_bot

# Ваш Telegram ID — узнать у @userinfobot (обязательно для админ-команд и заказов творога)
ADMIN_ID=

# IP-адрес вашего VPS (обязательно)
WG_SERVER_IP=
WG_PORT=51820
WG_INTERFACE=wg0
WG_DNS=1.1.1.1, 8.8.8.8
# Публичный ключ сервера WireGuard. Можно оставить пустым — бот возьмёт его сам из wg0
WG_SERVER_PUBLIC_KEY=

# ЮKassa (личный кабинет ЮKassa → Интеграция → Ключи API)
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=

# База данных и состояние бота
DATABASE_PATH=tvorog_vpn.db
PERSISTENCE_PATH=bot_state.pickle

# Лимиты
MAX_DEVICES=3
TRIAL_DAYS=3

# Веб-админка (необязательно). По умолчанию выключена и слушает только localhost.
ENABLE_API=false
API_PORT=8080
API_HOST=127.0.0.1
API_TOKEN=

# Бот поддержки (необязательно): второй бот от @BotFather
SUPPORT_BOT_TOKEN=
# Username бота поддержки без @ — на него ведут кнопки «Поддержка» в основном боте
SUPPORT_USERNAME=tvorog_support
# Куда приходят обращения. Пусто — вам (ADMIN_ID). Можно указать ID группы операторов
SUPPORT_CHAT_ID=
