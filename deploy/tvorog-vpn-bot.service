[Unit]
Description=Tvorog VPN Telegram Bot
After=network-online.target wg-quick@wg0.service
Wants=network-online.target

[Service]
Type=simple
# root нужен, чтобы бот мог добавлять клиентов в WireGuard (wg set)
User=root
WorkingDirectory=/opt/tvorog-vpn-bot
EnvironmentFile=/opt/tvorog-vpn-bot/.env
Environment=PYTHONUNBUFFERED=1
ExecStart=/opt/tvorog-vpn-bot/venv/bin/python bot.py
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
