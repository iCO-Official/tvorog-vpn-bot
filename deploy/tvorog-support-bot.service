[Unit]
Description=Tvorog VPN Support Bot
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/tvorog-vpn-bot
EnvironmentFile=/opt/tvorog-vpn-bot/.env
Environment=PYTHONUNBUFFERED=1
ExecStart=/opt/tvorog-vpn-bot/venv/bin/python support_bot.py
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
